<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetCare</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <style>
        body {
            background: #f4f9f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* NAVBAR BONITA */
        .navbar-wow {
            background: linear-gradient(135deg, #00c9a7, #92fe9d);
            padding: 12px;
        }

        .navbar-wow a {
            color: white !important;
            font-weight: 500;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 20px;
        }

        /* CONTENIDO */
        .container {
            margin-top: 20px;
        }

        /* FOOTER */
        footer {
            background: #222;
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 40px;
        }

        /* EFECTO CARDS */
        .card-wow {
            border: none;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .card-wow:hover {
            transform: translateY(-5px);
        }

        .btn-wow {
            background: #00c9a7;
            color: white;
            border-radius: 10px;
        }

        .btn-wow:hover {
            background: #00b39b;
            color: white;
        }
    </style>

</head>

<body>

<!-- NAVBAR -->
<header>
    <nav class="navbar navbar-expand-lg navbar-wow">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🐾 VetCare
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Citas" asp-action="Index">Citas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Mascotas" asp-action="Index">Mascotas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Propietarios" asp-action="Index">Propietarios</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Veterinarios" asp-action="Index">Veterinarios</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reportes" asp-action="Index">Reportes</a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>
</header>

<!-- CONTENIDO -->
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<!-- FOOTER -->
<footer>
    🐶 VetCare - Sistema de Veterinaria © 2026
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>