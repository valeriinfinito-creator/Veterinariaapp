@model List<VeterinariaApp.Models.Medicamento>

@{
ViewData["Title"] = "Medicamentos";
}

<h2 class="mb-3">💊 Medicamentos</h2>

<a class="btn btn-wow mb-3" asp-action="Create">
    ➕ Nuevo Medicamento
</a>

<table class="table table-hover shadow-sm bg-white rounded">

    <thead class="table-success">
    <tr>
        <th>Nombre</th>
        <th>Dosis</th>
        <th>Frecuencia</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
    <tr>

        <td>@item.Nombre</td>
        <td>@item.Dosis</td>
        <td>@item.Frecuencia</td>

        <td>

            <a class="btn btn-sm btn-primary"
               asp-action="Edit"
               asp-route-id="@item.Id">
                ✏️
            </a>

            <a class="btn btn-sm btn-danger"
               asp-action="Delete"
               asp-route-id="@item.Id">
                🗑
            </a>

        </td>

    </tr>
    }
    </tbody>

</table>