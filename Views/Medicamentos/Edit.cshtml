@model VeterinariaApp.Models.Medicamento

@{
ViewData["Title"] = "Editar Medicamento";
}

<h2>✏️ Editar Medicamento</h2>

<form asp-action="Edit" method="post" class="card card-wow p-4">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Dosis</label>
        <input asp-for="Dosis" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Frecuencia</label>
        <input asp-for="Frecuencia" class="form-control" />
    </div>

    <button type="submit" class="btn btn-wow">
        💾 Actualizar
    </button>

</form>