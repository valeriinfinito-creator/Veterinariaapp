@{
ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">

    <h1 class="fw-bold">🐾 VetCare</h1>
    <p class="text-muted">Sistema inteligente de gestión veterinaria</p>

</div>

<!-- HERO -->
<div class="card card-wow p-4 mb-4 text-center">

    <h3>Bienvenida 👋</h3>
    <p>
        Gestiona citas, mascotas, veterinarios y reportes de forma fácil y organizada.
    </p>

    <a class="btn btn-wow mt-2" asp-controller="Citas" asp-action="Index">
        🚀 Ir a Citas
    </a>

</div>

<!-- CARDS PRINCIPALES -->
<div class="row">

    <div class="col-md-3">
        <div class="card card-wow p-3 text-center">
            <i class="bi bi-calendar-check fs-1 text-success"></i>
            <h5>Citas</h5>
            <p class="text-muted">Agenda sin conflictos</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-wow p-3 text-center">
            <i class="bi bi-heart-pulse fs-1 text-danger"></i>
            <h5>Mascotas</h5>
            <p class="text-muted">Historial clínico completo</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-wow p-3 text-center">
            <i class="bi bi-person fs-1 text-primary"></i>
            <h5>Propietarios</h5>
            <p class="text-muted">Control de clientes</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-wow p-3 text-center">
            <i class="bi bi-graph-up fs-1 text-warning"></i>
            <h5>Reportes</h5>
            <p class="text-muted">Estadísticas inteligentes</p>
        </div>
    </div>

</div>

<!-- INFO FINAL -->
<div class="mt-5 text-center">

    <h5>💚 Todo en un solo sistema</h5>
    <p class="text-muted">
        Diseñado para mejorar la gestión de tu clínica veterinaria
    </p>

</div>