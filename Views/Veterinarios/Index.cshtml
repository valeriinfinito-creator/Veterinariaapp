@model List<VeterinariaApp.Models.Veterinario>

@{
ViewData["Title"] = "Veterinarios";
}

<h2 class="mb-3">👨‍⚕️ Veterinarios</h2>

<a class="btn btn-wow mb-3" asp-action="Create">
    ➕ Nuevo Veterinario
</a>

<table class="table table-hover shadow-sm bg-white rounded">

    <thead class="table-success">
    <tr>
        <th>Nombre</th>
        <th>Especialidad</th>
        <th>Horario</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
    <tr>

        <td>@item.Nombre</td>
        <td>@item.Especialidad</td>
        <td>@item.Horario</td>

        <td>

            <a class="btn btn-sm btn-primary"
               asp-action="Edit"
               asp-route-id="@item.Id">
                ✏️
            </a>

            <a class="btn btn-sm btn-info"
               asp-action="Details"
               asp-route-id="@item.Id">
                👁
            </a>

            <a class="btn btn-sm btn-danger"
               asp-action="Delete"
               asp-route-id="@item.Id">
                🗑
            </a>

        </td>

    </tr>
    }
    </tbody>

</table>