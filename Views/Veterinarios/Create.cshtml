@model VeterinariaApp.Models.Veterinario

@{
    ViewData["Title"] = "Nuevo Veterinario";
}

<h2>➕ Registrar Veterinario</h2>

<form asp-action="Create" method="post" class="card card-wow p-4">

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Especialidad</label>
        <input asp-for="Especialidad" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Horario</label>
        <input asp-for="Horario" class="form-control" />
    </div>

    <button type="submit" class="btn btn-wow">
        💾 Guardar
    </button>

</form>