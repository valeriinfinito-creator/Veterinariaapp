@model VeterinariaApp.Models.Mascota

@{
ViewData["Title"] = "Nueva Mascota";
}

<h2>➕ Registrar Mascota</h2>

<form asp-action="Create" method="post" class="card card-wow p-4">

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Especie</label>
        <input asp-for="Especie" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Raza</label>
        <input asp-for="Raza" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Edad</label>
        <input asp-for="Edad" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Peso (kg)</label>
        <input asp-for="Peso" type="number" step="0.1" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Propietario</label>
        <select asp-for="PropietarioId" class="form-select"
                asp-items="ViewBag.Propietarios">
        </select>
    </div>

    <button type="submit" class="btn btn-wow">
        💾 Guardar
    </button>

</form>